!student_load_manifest.json
!*_receipt.json
!collection_status.json
!expansion_status.json
!training/run_manifest.json
!training/status.json
!evaluation_followup/*.json
!evaluation_followup/final_holdout12/*.json
!evaluation_followup/final_holdout12/cases.csv
!evaluation_followup/version_01/*.json
!evaluation_followup/version_01/engineering_repairs.jsonl
!evaluation_followup/version_01/takeovers/*.json
!evaluation_followup/version_01/takeovers/engineering_repairs.jsonl
!evaluation_followup/version_01/original_training_snapshot/*.json
